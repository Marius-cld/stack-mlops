# Copier en .env (même dossier) puis remplir. Le .env n'est jamais versionné.
# Linux : mettre le résultat de `id -u` (macOS / Windows : laisser 50000)
AIRFLOW_UID=50000

# Générer : python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=

# Compte administrateur de l'interface Airflow (http://localhost:8080)
# créé par airflow-init au démarrage s'il n'existe pas encore
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=
